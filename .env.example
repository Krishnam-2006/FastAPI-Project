SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL: postgresql+psycopg://user:password@localhost/dbname
DATABASE_URL=postgresql+psycopg://user:password@localhost/blog
# Must be a SEPARATE database: tests drop all tables after each run
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost/blog_test

MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@fastapiblog.com
MAIL_USE_TLS=true
FRONTEND_URL=http://localhost:8000